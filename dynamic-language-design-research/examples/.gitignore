# Python bytecode caches are build output; never commit them.
__pycache__/
*.pyc
# minilang-c: the C VM binaries and compiled bytecode files are build output too.
*.exe
*.o
*.obj
*.mlc
minilang-c/mlvm
minilang-c/mlvm-*
# minilang-embed: the test and example programs and the shared library are build output.
*.dll
*.so
*.a
minilang-embed/test_embed
minilang-embed/test_embed_*
minilang-embed/mlfilter
