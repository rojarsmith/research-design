# kmemstress and lostwake in UPROGS. Applies to xv6-riscv commit
# fa2ddcb7ca87a77af579380a6eafd5aff163b44f with: patch -p1 < lab05-lockstat.patch
# (or git apply). Copy kmemstress.c and lostwake.c to user/ as well.
