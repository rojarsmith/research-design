diff -ruN a/kernel/schedinfo.h b/kernel/schedinfo.h
--- a/kernel/schedinfo.h
+++ b/kernel/schedinfo.h
@@ -0,0 +1,24 @@
+// Lab 06: scheduling statistics for one process. The kernel keeps them
+// in struct proc and the schedinfo() system call copies them out.
+// Latencies are in ticks of the RISC-V time CSR, which QEMU's virt
+// machine runs at 10 MHz, so 10 ticks are 1 microsecond.
+#ifndef SCHEDINFO_H
+#define SCHEDINFO_H
+
+#define PRIO_DEFAULT 1 // every new process starts here
+#define PRIO_MAX     9 // higher numbers run first
+
+// Histogram buckets: below 10 us, 100 us, 1 ms, 10 ms, 50 ms, 100 ms,
+// 200 ms, and everything above 200 ms.
+#define NLATHIST 8
+#define LATHIST_LIMITS {100, 1000, 10000, 100000, 500000, 1000000, 2000000}
+
+struct schedinfo {
+  uint64 nwake;  // wakeups measured: SLEEPING -> RUNNABLE -> RUNNING
+  uint64 latsum; // sum of the wakeup-to-run latencies
+  uint64 latmax; // the largest one
+  uint64 hist[NLATHIST];
+  int prio;      // the process's priority now
+};
+
+#endif
