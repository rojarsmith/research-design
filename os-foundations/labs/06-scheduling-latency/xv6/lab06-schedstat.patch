diff -ruN a/kernel/sysproc.c b/kernel/sysproc.c
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,40 @@
   release(&tickslock);
   return xticks;
 }
+
+// Lab 06: setprio(prio) sets the calling process's priority and returns
+// the old one. The round-robin scheduler ignores it.
+uint64
+sys_setprio(void)
+{
+  int prio, old;
+  struct proc *p = myproc();
+
+  argint(0, &prio);
+  if (prio < 0 || prio > PRIO_MAX)
+    return -1;
+  acquire(&p->lock);
+  old = p->prio;
+  p->prio = prio;
+  release(&p->lock);
+  return old;
+}
+
+// Lab 06: schedinfo(struct schedinfo *si) copies out the calling
+// process's wakeup-latency statistics.
+uint64
+sys_schedinfo(void)
+{
+  uint64 addr;
+  struct schedinfo si;
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  acquire(&p->lock);
+  si = p->si;
+  si.prio = p->prio;
+  release(&p->lock);
+  if (copyout(p->pagetable, p->sz, addr, (char *)&si, sizeof(si)) < 0)
+    return -1;
+  return 0;
+}
