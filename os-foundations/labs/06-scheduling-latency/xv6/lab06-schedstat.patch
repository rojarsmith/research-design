+// Lab 06: called with p->lock held just before p runs. If p was
+// woken up, record how long it waited between wakeup() and now.
+static void
+lat_account(struct proc *p)
+{
+  static const uint64 limits[NLATHIST - 1] = LATHIST_LIMITS;
+
+  if (p->readytime == 0)
+    return;
+  uint64 lat = r_time() - p->readytime;
+  p->readytime = 0;
+  p->si.nwake++;
+  p->si.latsum += lat;
+  if (lat > p->si.latmax)
+    p->si.latmax = lat;
+  int b = 0;
+  while (b < NLATHIST - 1 && lat >= limits[b])
+    b++;
+  p->si.hist[b]++;
+}
+
 // Per-CPU process scheduler.
 // Each CPU calls scheduler() after setting itself up.
 // Scheduler never returns.  It loops, doing:
