# blocks first and writes the header afterwards. Applies on top of
# lab07-crashpoint.patch with patch -p1. Undo with patch -R -p1.
diff -ruN a/kernel/log.c b/kernel/log.c
--- a/kernel/log.c
+++ b/kernel/log.c
@@ -252,8 +252,11 @@
   if (log.lh.n > 0) {
     write_log();      // Write modified blocks from cache to log
     crash_stop(1, 0);
-    write_head();     // Write header to disk -- the real commit
+    // Lab 07, broken on purpose: install the home blocks first and write
